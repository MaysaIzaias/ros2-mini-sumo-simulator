<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- ================================================= -->
    <!-- MACRO GENÉRICO PARA SENSOR DE DISTÂNCIA           -->
    <!-- ================================================= -->

    <xacro:macro
        name="range_sensor"
        params="
            name
            topic
            x
            y
            z
            yaw
            fov
            samples
            min_range
            max_range
            update_rate
        ">

        <!-- Representação visual do sensor -->

        <link name="${name}_link">

            <visual>

                <geometry>
                    <box size="0.012 0.016 0.008"/>
                </geometry>

                <material name="${name}_material">
                    <color rgba="0.1 0.1 0.1 1.0"/>
                </material>

            </visual>

        </link>


        <!-- Liga o sensor ao chassi -->

        <joint name="${name}_joint" type="fixed">

            <parent link="base_link"/>

            <child link="${name}_link"/>

            <origin
                xyz="${x} ${y} ${z}"
                rpy="0 0 ${yaw}"/>

        </joint>


        <!-- Sensor simulado no Gazebo -->

        <gazebo reference="${name}_link">

            <sensor
                name="${name}_sensor"
                type="gpu_lidar">

                <topic>${topic}</topic>

                <gz_frame_id>${name}_link</gz_frame_id>

                <update_rate>${update_rate}</update_rate>

                <always_on>true</always_on>

                <visualize>true</visualize>


                <ray>

                    <scan>

                        <horizontal>

                            <samples>${samples}</samples>

                            <resolution>1</resolution>

                            <min_angle>${-fov/2.0}</min_angle>

                            <max_angle>${fov/2.0}</max_angle>

                        </horizontal>


                        <vertical>

                            <samples>1</samples>

                            <resolution>1</resolution>

                            <min_angle>0</min_angle>

                            <max_angle>0</max_angle>

                        </vertical>

                    </scan>


                    <range>

                        <min>${min_range}</min>

                        <max>${max_range}</max>

                        <resolution>0.005</resolution>

                    </range>

                </ray>

            </sensor>

        </gazebo>

    </xacro:macro>

</robot>
